# ==============================================================================
# Kia Update Checker - Umgebungsvariablen / Konfiguration
# ==============================================================================
# Kopieren Sie diese Datei nach `.env` und tragen Sie Ihre Werte ein:
#   cp .env.example .env
# ==============================================================================

# Fahrzeug-Identifizierungsnummer (FIN / VIN Ihres Kia)
# Beispiel: KNA... (17-stellige FIN)
KIA_VIN=

# Aktuell im Fahrzeug installierte Version (Veröffentlichungsmonat)
# Format: MM.YYYY (z. B. 07.2026) oder YYYY.MM (z. B. 2026.07)
KIA_INSTALLED_VERSION=2026.07

# Telegram Bot Benachrichtigung (Optional)
# Erstellen Sie einen Bot über @BotFather und ermitteln Sie Ihre Chat-ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Region & Sprache (Standard: EU / DE für Europa & Deutschland)
KIA_BRAND=KM
KIA_REGION=EU
KIA_LANG=DE
